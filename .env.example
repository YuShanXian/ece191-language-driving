# All relative paths below resolve from the repository root.
# Copy to .env and use: node --env-file=.env sim/server.cjs
DEMO_PORT=8775
ECE191_DATA_ROOT=.
DEMO_TRACE_ROOT=logs
ECE191_REVIEW_ROOT=logs/reviews
ECE191_REVIEW_DATA_ROOT=sim/review-data
ECE191_SCENES_ROOT=sim/data/scenes
# Override the external map directly if needed:
# ECE191_MAP_PATH=data/nuplan/maps/us-nv-las-vegas-strip/9.15.1915/map.gpkg
# Default Python: .venv/Scripts/python.exe on Windows; .venv/bin/python elsewhere.
# If no local environment exists, python (Windows) or python3 must be on PATH.
# ECE191_PYTHON=.venv/Scripts/python.exe
# WSL is opt-in; replace the example with your own Linux Python executable:
# ECE191_PYTHON=["wsl.exe","--exec","/path/to/environment/bin/python"]
# Provider CLIs are discovered on PATH; optional explicit executable paths:
# ECE191_CODEX=codex
# ECE191_CLAUDE=claude
# ECE191_GEMINI=gemini
# ECE191_AGY=agy
# ECE191_PARSER_PROMPT=sim/parser/prompt.txt
